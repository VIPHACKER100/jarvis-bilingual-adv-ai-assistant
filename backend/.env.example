# Server Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security
CONFIRMATION_TIMEOUT=30
ENABLE_DANGEROUS_COMMANDS=true

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# WhatsApp
WHATSAPP_DESKTOP_PATH=
AUTO_DETECT_WHATSAPP=true

# API Keys
NVIDIA_API_KEY=nvapi-XXXXXX
OPENROUTER_API_KEY=sk-or-v1-XXXXXX

# LLM Configuration
LLM_PROVIDER=nvidia
NVIDIA_MODEL=qwen/qwen2.5-7b-instruct
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Wake-Word Engine
WAKE_WORD_ENABLED=true
WAKE_WORD_PHRASE=jarvis
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# Mobile Sync
PAIRING_SECRET=JARVIS-SECRET-KEY
MDNS_ENABLED=true
MDNS_SERVICE_NAME=JARVIS-CORE
