# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security
BACKEND_API_KEY=your-secure-api-key
CONFIRMATION_TIMEOUT=30
ENABLE_DANGEROUS_COMMANDS=true

# Database
DB_PATH=data/jarvis.db

# Logging
LOG_LEVEL=INFO

# API Keys (at least one required)
OPENROUTER_API_KEY=sk-or-v1-XXXXXX
NVIDIA_API_KEY=nvapi-XXXXXX
OPENAI_API_KEY=sk-XXXXXX
GOOGLE_API_KEY=AIzaXXXXXX

# LLM Provider (openrouter | nvidia | openai | google | ollama)
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001
NVIDIA_MODEL=qwen/qwen2.5-7b-instruct
OPENAI_MODEL=gpt-4o-mini
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# Ollama (optional, local)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3

# Wake Word (requires pyaudio + openwakeword — not installed by default)
WAKE_WORD_ENABLED=false
WAKE_WORD_PHRASE=jarvis
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# Mobile Sync
PAIRING_SECRET=JARVIS-SECRET-KEY
