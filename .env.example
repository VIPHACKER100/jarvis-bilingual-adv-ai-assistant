# JARVIS v4.0 — Environment Configuration
# Copy this to .env and fill in your values.

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@localhost:5432/jarvis
POSTGRES_PASSWORD=jarvis_dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Provider (nvidia | openrouter | openai | ollama)
LLM_PROVIDER=nvidia

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqc-v1

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google / Gemini
GEMINI_API_KEY=

# Ollama (local)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3

# Backend API Key (shared secret between frontend and backend)
BACKEND_API_KEY=

# Frontend env vars (also available at build time)
VITE_JARVIS_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free

# Security
CONFIRMATION_TIMEOUT=30
ENABLE_DANGEROUS_COMMANDS=true

# Wake Word (Windows only)
WAKE_WORD_ENABLED=false
WAKE_WORD_PHRASE=jarvis
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# Mobile Sync & Auto-Discovery
MDNS_ENABLED=true
MDNS_SERVICE_NAME=JARVIS-CORE
PAIRING_SECRET=JARVIS-SECRET-KEY

# OpenTelemetry (structured tracing)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Audio & TTS
TTS_VOICE=alloy
TTS_LANGUAGE=en
STT_LANGUAGE=en
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
